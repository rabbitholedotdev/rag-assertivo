# Copy to .env. Nothing in this file is a secret.

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=publico_br

# --- Retrieval ---
EMBED_MODEL=intfloat/multilingual-e5-large
RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual
RAG_RERANK=1
RAG_POOLS_SEPARADOS=0
RAG_PENALIDADE_SINTETICO=0.0

# --- MCP ---
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_HTTP_PATH=/mcp
MCP_AUTH_TOKEN=

# --- Generation (optional; extractive stub is the default) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
RAG_GEN_MODEL=extractive
RAG_VERIFY_MODEL=
RAG_DEADLINE_S=60

# --- Tracing (optional; either backend, never both required) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=rag-assertivo

HF_HOME=/models
FASTEMBED_CACHE_DIR=/models
HF_HUB_DISABLE_SHARED_BLOBS=1
